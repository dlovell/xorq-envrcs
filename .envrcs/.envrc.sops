use_sops() {
    # https://github.com/direnv/direnv/wiki/Sops#how-to-encrypt
    local path=${1:-$direnv_root/.envrcs/.env.secrets.concatenated.sops-encrypted}
    local output_type=${2:-dotenv}
    local decrypted

    # watch before decrypting: a file that fails to decrypt is still watched,
    # so fixing it (or the key) retriggers the reload.
    watch_file "$path"

    if [ "$output_type" = "dotenv" ]; then
        decrypted=$(sops --decrypt --input-type dotenv --output-type dotenv "$path") || {
            log_error "sops --decrypt failed for $path"
            return 1
        }
        eval "$(echo "$decrypted" | direnv dotenv bash /dev/stdin)"
    else
        decrypted=$(sops --decrypt --input-type "$output_type" --output-type "$output_type" "$path") || {
            log_error "sops --decrypt failed for $path"
            return 1
        }
        eval "$decrypted"
    fi
}

use_sops_if_exists() {
    # same default as use_sops, so a bare `use sops_if_exists` is not a no-op
    local path=${1:-$direnv_root/.envrcs/.env.secrets.concatenated.sops-encrypted}
    if [ -f "$path" ]; then
        use_sops "$path" "${@:2}"
    fi
}
