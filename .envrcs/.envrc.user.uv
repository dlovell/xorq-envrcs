# Watch before the test below, so creating pyproject.toml later retriggers
# the reload instead of leaving the fragment skipped until a manual
# `direnv reload`. uv.lock too: a pull that bumps pinned versions touches
# only the lock, and without a watch the venv would go quietly stale.
# (The flake fragment needs no equivalent — nix-direnv watches flake.lock.)
watch_file "$direnv_root/pyproject.toml"
watch_file "$direnv_root/uv.lock"

# No-op when there is no project to sync, so this fragment can stay enabled
# in a repo that has no pyproject.toml yet.
if [ -f "$direnv_root/pyproject.toml" ]; then
    # --project for the same reason .envrc.user.flake passes $direnv_root:
    # this fragment runs with PWD at .envrcs/, and leaning on uv's upward
    # project discovery would break the moment .envrcs/ grows a pyproject.toml.
    uv sync --project "$direnv_root" --all-extras --all-groups &&
        source "$direnv_root/.venv/bin/activate"
    # Re-record uv.lock: the watch above ran before `uv sync`, which is
    # what writes it, so on a first sync (or any that re-resolves) direnv
    # would see a stale watch at the very next prompt and do a second full
    # reload — another uv sync — before settling.
    watch_file "$direnv_root/uv.lock"
else
    log_status "no pyproject.toml in $direnv_root; skipping uv sync"
fi
