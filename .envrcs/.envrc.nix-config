if ! has nix_direnv_version || ! nix_direnv_version 3.0.5; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.5/direnvrc" "sha256-RuwIS+QKFj/T9M2TFXScjBsLR6V3A17YVoEW/Q6AZ1w="
fi

# nix-direnv watches flake.nix / flake.lock, but NOT the modules they import,
# so edits to those don't invalidate the cached devShell. Watch them by hand.
# Paths are relative to .envrcs/. This repo ships no nix files; uncomment and
# adjust once it does.
# https://github.com/nix-community/nix-direnv/pull/148#issuecomment-1049287263
# watch_file ../nix/{commands,packages}.nix
