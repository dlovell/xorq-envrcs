source_env .envrc.nix-config

# Watch before the test, so a flake.nix added later retriggers the reload.
# See .envrcs/README.md, "sops", for why watch-before-test is the rule.
watch_file "$direnv_root/flake.nix"

# No-op when there is no flake to build, so this fragment can stay enabled
# in a repo that has no flake.nix yet.
if [ -f "$direnv_root/flake.nix" ]; then
    # The argument is not optional: nix-direnv's use_flake defaults its
    # expression to ".", and this fragment runs with PWD at .envrcs/, so a
    # bare `use flake` would evaluate .envrcs and watch a flake.nix that
    # isn't there.
    #
    # Running from the root matters separately, because nix-direnv derives
    # more than the flake expression from PWD. See .envrc for the layout-dir
    # half. The other half is the generated nix-direnv-reload helper, whose
    # body bakes in $PWD at generation time: from .envrcs/ its
    # `touch "$PWD/.envrc"` would *create* a stray .envrcs/.envrc, which
    # direnv then finds instead of the root one and refuses as unallowed.
    pushd "$direnv_root" >/dev/null || return 1
    use flake "$direnv_root"
    popd >/dev/null
else
    log_status "no flake.nix in $direnv_root; skipping use flake"
fi
