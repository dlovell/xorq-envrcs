source_env .envrc.sops

# Single-bundle demo. Paths are relative to .envrcs/.
#
# The demo bundle is encrypted to demo-age-key.txt, a throwaway private key
# committed beside it, so every clone can decrypt it without first being
# handed a key. The key file is named only here, as a var-assignment prefix:
# bash discards it when the function returns, so it cannot become the
# default for a real bundle.
SOPS_AGE_KEY_FILE="$direnv_root/.envrcs/demo-age-key.txt" \
    use sops_if_exists .env.secrets.demo.sops-encrypted

# Production shape: one bundle built from many plaintext sources, so the
# environment costs a single sops invocation. Each use_sops spawns a sops
# process and a key-agent round trip, so N bundles cost N of them and make
# `direnv reload` noticeably slower.
#
# Single-quote any value containing a $ in the plaintext sources:
# `direnv dotenv` expands it and silently truncates the value. See the
# "Quote values containing $" section of .envrcs/README.md.
#
# Build it without the merged plaintext ever touching disk:
#   bundle=.envrcs/.env.secrets.concatenated.sops-encrypted
#   cat a.env b.env |
#     sops --encrypt --pgp "$FPR" --input-type dotenv --output-type dotenv /dev/stdin \
#     > "$bundle.tmp" &&
#     mv "$bundle.tmp" "$bundle"
#
# sops has no --stdin flag, and bare `sops --encrypt` fails with "no file
# specified" despite its help text — /dev/stdin must be named explicitly.
# --input-type/--output-type are required because there is no filename
# extension for sops to sniff. With no .sops.yaml there are no creation
# rules either, so the recipient must be named: --pgp <fingerprint>, or
# --age <public key> as the demo bundle does.
#
# Write through .tmp and mv: `>` creates the output file before sops runs,
# so a failed encrypt would otherwise leave a truncated bundle that
# use_sops_if_exists treats as existing and fails to decrypt on every
# reload. The .tmp name stays ignored (.envrcs/.env.* matches it, and
# !*.sops-encrypted does not re-include it).
#
# use sops_if_exists .env.secrets.concatenated.sops-encrypted
