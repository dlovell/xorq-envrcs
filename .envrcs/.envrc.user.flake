source_env .envrc.nix-config

# Watch before the test below, so creating flake.nix later retriggers the
# reload instead of leaving the fragment skipped until a manual
# `direnv reload`.
watch_file "$direnv_root/flake.nix"

# No-op when there is no flake to build, so this fragment can stay enabled
# in a repo that has no flake.nix yet.
if [ -f "$direnv_root/flake.nix" ]; then
    # `use flake` for a non-mutable install. The argument is not optional:
    # this fragment is sourced with PWD at .envrcs/, so a bare `use flake`
    # would evaluate .envrcs, watch a flake.nix that isn't there, and never
    # invalidate the cached devShell when the real flake changes.
    # Run from the root, not from .envrcs/. direnv resolves its layout dir
    # as ${direnv_layout_dir:-$PWD/.direnv}, and the wiki's popular
    # cache-relocation snippet redefines direnv_layout_dir as a function
    # keyed on $PWD, which ignores the variable the root .envrc sets. Either
    # way the flake profile and its nix GC root would otherwise be keyed on
    # .envrcs/ while .venv sits at the root.
    pushd "$direnv_root" >/dev/null
    use flake "$direnv_root"
    popd >/dev/null
else
    log_status "no flake.nix in $direnv_root; skipping use flake"
fi
