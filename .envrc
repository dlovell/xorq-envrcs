export direnv_root=$(pwd)

# Auto-create the untracked local files from their tracked templates, so a
# fresh clone needs nothing but `direnv allow`. Existing files are never
# overwritten. NOTE: deleting one of these does not disable it — it is
# recreated on the next reload. To durably disable a fragment, empty it
# (`> .envrcs/.envrc.user`); an empty file satisfies the check below and is a
# no-op when sourced.
if [ ! -f .gitignore ]; then
    install -m 644 .gitignore.template .gitignore
fi
if [ ! -f .envrcs/.envrc.secrets ]; then
    install -m 600 .envrcs/.envrc.secrets.template .envrcs/.envrc.secrets
fi
if [ ! -f .envrcs/.envrc.user ]; then
    install -m 600 .envrcs/.envrc.user.template .envrcs/.envrc.user
fi

source_env_if_exists .envrcs/.envrc.secrets
source_env_if_exists .envrcs/.envrc.user
