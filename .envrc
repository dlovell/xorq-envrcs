export direnv_root=$(pwd)

# direnv's stdlib resolves its layout dir as ${direnv_layout_dir:-$PWD/.direnv},
# and the fragments below run with PWD at .envrcs/ (source_env pushd's into
# the fragment's directory). Without this, nix-direnv's flake profile and its
# nix GC root would land in .envrcs/.direnv while .venv sits at the root, and
# `rm -rf .direnv` from here would leave the stale profile and root behind.
# Only a default: `:-` so a direnvrc that sets direnv_layout_dir itself keeps
# its value — direnv sources the direnvrc before this file, and a plain
# assignment here would silently override the user's own choice. A direnvrc
# that redefines direnv_layout_dir as a *function* ignores the variable
# either way, which is why .envrc.user.flake anchors PWD as well.
direnv_layout_dir=${direnv_layout_dir:-$direnv_root/.direnv}

# Auto-create the untracked local files from their tracked templates, so a
# fresh clone needs nothing but `direnv allow`. Existing files are never
# overwritten. NOTE: deleting one of these does not disable it — it is
# recreated on the next reload. To durably disable a fragment, empty it
# (`> .envrcs/.envrc.user`); an empty file satisfies the check below and is a
# no-op when sourced.
if [ ! -f .gitignore ]; then
    install -m 644 .gitignore.template .gitignore
fi
if [ ! -f .envrcs/.envrc.secrets ]; then
    install -m 600 .envrcs/.envrc.secrets.template .envrcs/.envrc.secrets
fi
if [ ! -f .envrcs/.envrc.user ]; then
    install -m 600 .envrcs/.envrc.user.template .envrcs/.envrc.user
fi

source_env_if_exists .envrcs/.envrc.secrets
source_env_if_exists .envrcs/.envrc.user
