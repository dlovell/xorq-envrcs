source_env .envrc.sops

# Decrypts this repo's demo bundle. Paths are relative to .envrcs/, and
# ../secrets.yaml is also the default when no path is given.
use sops_if_exists ../secrets.yaml

# Add further bundles as needed — each one costs a sops invocation, so many
# of them make `direnv reload` noticeably slower.
# use sops_if_exists .env.secrets.other.sops-encrypted
